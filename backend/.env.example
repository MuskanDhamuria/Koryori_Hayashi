NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
# Supabase example:
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
# DIRECT_URL=postgresql://postgres:[PASSWORD]@[DB-HOST]:5432/postgres?sslmode=require
DATABASE_URL=
DIRECT_URL=
JWT_SECRET=longerthan32ch
JWT_EXPIRES_IN=7d
CUSTOMER_APP_ORIGIN=http://localhost:5173
COMPANY_APP_ORIGIN=http://localhost:5174
QUEUE_APP_ORIGIN=http://localhost:5175
DIGITAL_TWIN_APP_ORIGIN=http://localhost:5176
# Optional: comma-separated additional origins (e.g. Vercel preview domains)
# APP_ORIGINS=https://my-preview-1.vercel.app,https://my-preview-2.vercel.app
APP_ORIGINS=
SEED_STAFF_EMAIL=
SEED_STAFF_PASSWORD=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_TIMEOUT_MS=60000
SYNC_STATE_PATH=.data/spreadsheet-sync.json
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
